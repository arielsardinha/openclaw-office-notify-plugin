{
  "id": "openclaw-office-notify",
  "name": "OpenClaw Office Notify",
  "description": "Envia estado dos agentes ao painel OpenClaw Office. Somente local e somente observação.",
  "version": "3.0.0",
  "activation": {
    "onStartup": true,
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "endpoint": {
        "type": "string",
        "description": "Endpoint do painel (somente loopback)",
        "default": "http://127.0.0.1:4200/api/workflow"
      },
      "apiToken": {
        "type": "string",
        "description": "Bearer token do painel (prefira apiTokenFile)"
      },
      "apiTokenFile": {
        "type": "string",
        "description": "Caminho de um arquivo (0600) contendo o token do painel"
      },
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "timeoutMs": {
        "type": "number",
        "default": 2000
      },
      "orchestratorAgent": {
        "type": "string",
        "description": "Id do agente que recebe as mensagens do usuário",
        "default": "coordinator"
      },
      "includeContent": {
        "type": "boolean",
        "description": "Enviar texto de mensagens e tarefas ao painel",
        "default": false
      }
    }
  },
  "uiHints": {
    "apiToken": {
      "label": "API Token do painel",
      "sensitive": true
    },
    "includeContent": {
      "label": "Enviar conteúdo das mensagens"
    },
    "apiTokenFile": {
      "label": "Arquivo do token do painel"
    }
  }
}
